# Copiá este archivo a .env y completá los valores.
# Ninguno de estos valores es real: es solo la lista de lo que hace falta.

# ── Obligatorias: sin esto la app no arranca ────────────────────────────────
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Saltea RLS. NUNCA la expongas al cliente: solo se usa en /api/book y en los
# scripts de e2e-local/. Si alguna vez aparece en un archivo con "use client",
# es un incidente de seguridad.
SUPABASE_SERVICE_ROLE_KEY=


# ── Mails ───────────────────────────────────────────────────────────────────
# Sin estas cuatro NO sale ningún mail: ni la confirmación al cliente ni el
# aviso de turno nuevo al dueño. `sendEmail` devuelve EMAIL_NOT_CONFIGURED y la
# reserva se guarda igual (a propósito: no se pierde un turno porque falle el
# proveedor de mail).
#
# Proveedor: Mailjet. Autentica con las DOS claves, no con un bearer.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Tiene que ser una dirección VERIFICADA en Mailjet.
EMAIL_FROM=
EMAIL_FROM_NAME=Turnito

# Muestra el campo de email en la reserva y manda la confirmación al cliente.
# ⚠️ NO alcanza con poner "1": hay un checklist de 4 pasos (migración 0002,
# remitente verificado, texto legal) en el header de lib/email.ts. Leelo antes.
# El aviso al DUEÑO y el formulario de contacto no dependen de este flag.
NEXT_PUBLIC_EMAIL_ENABLED=


# ── Opcionales ──────────────────────────────────────────────────────────────

# Monitoreo de errores. Sin esto Sentry queda apagado y la app arranca igual,
# pero avisa por consola: "el monitoreo de errores está APAGADO".
# Sentry → Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Sal para hashear la IP en el rate limit de reservas (nunca guardamos la IP en
# claro: es dato personal). Si no está, cae a la service role key.
# Poné cualquier string largo y aleatorio.
RATE_LIMIT_SALT=


# ── Panel de la plataforma (/admin) ─────────────────────────────────────────
# Quiénes pueden ver cuántas cuentas hay, cuánto le queda a cada negocio y
# tocar los vencimientos. Mails separados por coma.
#
# SIN ESTA VARIABLE /admin ES UN 404 PARA TODOS, incluido vos. Es a propósito:
# la pantalla ve los datos de todos los clientes, así que falla cerrada.
#
# ⚠️ El mail tiene que ser el de una cuenta que YA EXISTA en Turnito. Si ponés
# uno que nadie registró, cualquiera puede crear esa cuenta en /login y entrar.
# Registrala primero, después agregá la variable.
#
# Nunca le pongas NEXT_PUBLIC_: si viaja al browser, la lista de admins queda
# publicada en el bundle.
ADMIN_EMAILS=


# ── Solo para correr migraciones ────────────────────────────────────────────
# Va en .env.local, NO acá. Supabase → botón Connect → Session pooler.
# Sin esto no funciona `npm run db:migrate`.
#
# SUPABASE_DB_PASSWORD=
